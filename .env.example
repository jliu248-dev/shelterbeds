# Copy this file to .env and fill in your own values. Never commit .env.

# Tells `flask` commands where the app is.
FLASK_APP=wsgi.py

# "development" locally, "production" on Cloud Run.
APP_ENV=development

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave blank to use a local SQLite file (instance/shelterbeds.db).
# Example for Postgres: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Used once by seed_admin.py to create the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
